<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Promote IDE/analyzer diagnostics to errors in CI builds -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Suppress known vulnerabilities until fixed upstream -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLitePCLRaw.lib.e_sqlite3 2.1.11 — no patched version available yet via transitive chain; suppressed pending upstream fix -->
    <NuGetAuditSuppressAdvisory Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
    <!-- MessagePack 2.5.192 — transitive via LiveStreamingServerNet; suppressed pending upstream upgrade -->
    <NuGetAuditSuppressAdvisory Include="https://github.com/advisories/GHSA-2f33-pr97-265q" />
    <NuGetAuditSuppressAdvisory Include="https://github.com/advisories/GHSA-2x83-8g95-xh59" />
    <NuGetAuditSuppressAdvisory Include="https://github.com/advisories/GHSA-cj9g-3mj2-g8vv" />
    <NuGetAuditSuppressAdvisory Include="https://github.com/advisories/GHSA-cxmj-83gh-fp49" />
    <NuGetAuditSuppressAdvisory Include="https://github.com/advisories/GHSA-hv8m-jj95-wg3x" />
    <NuGetAuditSuppressAdvisory Include="https://github.com/advisories/GHSA-q2h6-ghwm-5qm8" />
    <NuGetAuditSuppressAdvisory Include="https://github.com/advisories/GHSA-qhmf-xw27-6rqr" />
    <NuGetAuditSuppressAdvisory Include="https://github.com/advisories/GHSA-v72x-2h86-7f8m" />
    <NuGetAuditSuppressAdvisory Include="https://github.com/advisories/GHSA-vh6j-jc39-fggf" />
    <NuGetAuditSuppressAdvisory Include="https://github.com/advisories/GHSA-w567-gjr2-hm5j" />
    <NuGetAuditSuppressAdvisory Include="https://github.com/advisories/GHSA-wfr3-xj75-pfwh" />
  </ItemGroup>

</Project>
