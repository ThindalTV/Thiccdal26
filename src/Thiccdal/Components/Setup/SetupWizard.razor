@page "/setup"

@using Thiccdal.Infrastructure.Setup

<PageTitle>Thiccdal Setup</PageTitle>

<div class="setup-wizard">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="text-center mb-4">
                    <h1 class="display-5 fw-bold">Thiccdal Setup</h1>
                    <p class="text-muted">Step @(CurrentStepIndex + 1) of @Steps.Count</p>
                </div>

                <!-- Progress bar -->
                <div class="progress mb-4" style="height: 8px;">
                    <div class="progress-bar" role="progressbar"
                         style="width: @ProgressPercent%"
                         aria-valuenow="@ProgressPercent"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>
                </div>

                <!-- Step indicators -->
                <div class="d-flex justify-content-between mb-4">
                    @foreach (var (step, index) in Steps.Select((s, i) => (s, i)))
                    {
                        <div class="text-center flex-fill">
                            <div class="step-indicator @GetStepClass(index)">
                                @if (index < CurrentStepIndex)
                                {
                                    <span class="bi bi-check"></span>
                                }
                                else
                                {
                                    @(index + 1)
                                }
                            </div>
                            <small class="d-none d-md-block text-muted mt-1">@step.Name</small>
                        </div>
                    }
                </div>

                <!-- Step content card -->
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">@CurrentStep.Name</h5>
                        @if (CurrentStep.IsOptional)
                        {
                            <span class="badge bg-secondary ms-2">Optional</span>
                        }
                    </div>
                    <div class="card-body">
                        <p class="text-muted mb-4">@CurrentStep.Description</p>

                        @* Step content rendered here via RenderFragment *@
                        @ChildContent

                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <button class="btn btn-outline-secondary"
                                @onclick="PreviousStep"
                                disabled="@(CurrentStepIndex == 0)">
                            <span class="bi bi-arrow-left me-1"></span> Back
                        </button>

                        <div>
                            @if (CurrentStep.IsOptional)
                            {
                                <button class="btn btn-outline-secondary me-2" @onclick="SkipStep">
                                    Skip
                                </button>
                            }

                            @if (CurrentStepIndex < Steps.Count - 1)
                            {
                                <button class="btn btn-primary"
                                        @onclick="NextStep"
                                        disabled="@(!CanProceed)">
                                    Next <span class="bi bi-arrow-right ms-1"></span>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-success"
                                        @onclick="CompleteSetup"
                                        disabled="@(!CanProceed)">
                                    <span class="bi bi-check-circle me-1"></span> Complete Setup
                                </button>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool CanProceed { get; set; } = true;

    [Parameter]
    public EventCallback OnStepChanged { get; set; }

    [Parameter]
    public EventCallback OnSetupComplete { get; set; }

    private IReadOnlyList<WizardStepModel> Steps { get; set; } = WizardStepCatalog.GetSteps();

    private int CurrentStepIndex { get; set; }

    private WizardStepModel CurrentStep => Steps[CurrentStepIndex];

    private int ProgressPercent => (int)((CurrentStepIndex + 1) / (double)Steps.Count * 100);

    private string GetStepClass(int index)
    {
        if (index < CurrentStepIndex) return "step-complete";
        if (index == CurrentStepIndex) return "step-active";
        return "step-pending";
    }

    private async Task NextStep()
    {
        if (CurrentStepIndex < Steps.Count - 1)
        {
            CurrentStepIndex++;
            await OnStepChanged.InvokeAsync();
        }
    }

    private async Task PreviousStep()
    {
        if (CurrentStepIndex > 0)
        {
            CurrentStepIndex--;
            await OnStepChanged.InvokeAsync();
        }
    }

    private async Task SkipStep()
    {
        await NextStep();
    }

    private async Task CompleteSetup()
    {
        await OnSetupComplete.InvokeAsync();
    }

    public WizardStep GetCurrentStep() => CurrentStep.Step;

    public void SetStep(int index)
    {
        if (index >= 0 && index < Steps.Count)
        {
            CurrentStepIndex = index;
            StateHasChanged();
        }
    }
}
