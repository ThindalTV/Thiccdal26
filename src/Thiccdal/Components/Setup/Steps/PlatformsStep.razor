@using Thiccdal.Infrastructure.Setup

<div class="platforms-step">
    <p class="text-muted mb-4">
        Connect your streaming platforms to enable chat aggregation, event tracking, and bot features.
        <strong>This step is optional</strong> — you can configure platforms later from the Integrations page.
    </p>

    <div class="row g-4">
        <!-- Twitch -->
        <div class="col-md-4">
            <div class="card h-100 platform-card @(_twitchConnected ? "border-success" : "")">
                <div class="card-body text-center">
                    <span class="bi bi-twitch display-4" style="color: #9146FF;"></span>
                    <h5 class="card-title mt-3">Twitch</h5>
                    <p class="card-text text-muted small">
                        Chat, follows, subs, bits, raids, and channel point redeems
                    </p>
                    @if (_twitchConnected)
                    {
                        <span class="badge bg-success">
                            <span class="bi bi-check-circle me-1"></span>
                            Connected
                        </span>
                    }
                    else
                    {
                        <button class="btn btn-outline-primary btn-sm" @onclick="ConnectTwitch">
                            <span class="bi bi-link-45deg me-1"></span>
                            Connect
                        </button>
                    }
                </div>
            </div>
        </div>

    </div>

    <div class="mt-4 text-center">
        <small class="text-muted">
            <span class="bi bi-info-circle me-1"></span>
            Platform connections require OAuth authentication. You'll be redirected to authorize Thiccdal.
        </small>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback<bool> OnValidationChanged { get; set; }

    private bool _twitchConnected;

    protected override async Task OnInitializedAsync()
    {
        await OnValidationChanged.InvokeAsync(true);
    }

    private async Task ConnectTwitch()
    {
        _twitchConnected = true;
        await Task.CompletedTask;
    }
}
