@using Thiccdal.Infrastructure.Setup

<div class="summary-step">
    <p class="text-muted mb-4">
        Review your configuration before completing setup.
    </p>

    <!-- Database -->
    <div class="card bg-dark mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="mb-1">
                        <span class="bi bi-database me-2 text-primary"></span>
                        Database
                    </h6>
                    <small class="text-muted">@DatabaseSummary</small>
                </div>
                <span class="badge bg-success">
                    <span class="bi bi-check-circle me-1"></span>
                    Connected
                </span>
            </div>
        </div>
    </div>

    <!-- Platforms -->
    <div class="card bg-dark mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="mb-1">
                        <span class="bi bi-broadcast me-2 text-primary"></span>
                        Platforms
                    </h6>
                    <small class="text-muted">
                        @if (ConnectedPlatforms.Count > 0)
                        {
                            @string.Join(", ", ConnectedPlatforms)
                        }
                        else
                        {
                            <span>None configured (can be added later)</span>
                        }
                    </small>
                </div>
                @if (ConnectedPlatforms.Count > 0)
                {
                    <span class="badge bg-success">
                        <span class="bi bi-check-circle me-1"></span>
                        @ConnectedPlatforms.Count Connected
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">Skipped</span>
                }
            </div>
        </div>
    </div>

    <!-- AI -->
    <div class="card bg-dark mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="mb-1">
                        <span class="bi bi-robot me-2 text-primary"></span>
                        AI Integration
                    </h6>
                    <small class="text-muted">
                        @if (AiEnabled)
                        {
                            @AiEndpoint
                        }
                        else
                        {
                            <span>Disabled (can be enabled later)</span>
                        }
                    </small>
                </div>
                @if (AiEnabled)
                {
                    <span class="badge bg-success">
                        <span class="bi bi-check-circle me-1"></span>
                        Enabled
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">Disabled</span>
                }
            </div>
        </div>
    </div>

    <!-- Bot -->
    <div class="card bg-dark mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="mb-1">
                        <span class="bi bi-chat-dots me-2 text-primary"></span>
                        Chatbot
                    </h6>
                    <small class="text-muted">
                        Bot name: <strong>@BotName</strong>
                        @if (TimedMessageCount > 0)
                        {
                            <span> • @TimedMessageCount timed message(s)</span>
                        }
                    </small>
                </div>
                <span class="badge bg-success">
                    <span class="bi bi-check-circle me-1"></span>
                    Configured
                </span>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-4">
        <span class="bi bi-info-circle me-2"></span>
        Click <strong>Complete Setup</strong> to save your configuration and start using Thiccdal.
        All settings can be changed later from the admin panel.
    </div>
</div>

@code {
    [Parameter]
    public string DatabaseSummary { get; set; } = "PostgreSQL @ localhost:5432/thiccdal";

    [Parameter]
    public List<string> ConnectedPlatforms { get; set; } = new();

    [Parameter]
    public bool AiEnabled { get; set; }

    [Parameter]
    public string AiEndpoint { get; set; } = string.Empty;

    [Parameter]
    public string BotName { get; set; } = "Thiccdal";

    [Parameter]
    public int TimedMessageCount { get; set; }

    [Parameter]
    public EventCallback<bool> OnValidationChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await OnValidationChanged.InvokeAsync(true);
    }
}
