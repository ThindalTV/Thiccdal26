@inject ISetupStateService SetupStateService
@inject NavigationManager Navigation

@using Thiccdal.Infrastructure.Setup

@implements IDisposable

@if (_isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _isLoading = true;
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var isComplete = await SetupStateService.IsSetupComplete(_cts.Token);
            
            if (!isComplete)
            {
                var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
                if (!currentPath.StartsWith("setup", StringComparison.OrdinalIgnoreCase))
                {
                    Navigation.NavigateTo("/setup", replace: true);
                    return;
                }
            }
        }
        catch (Exception)
        {
            Navigation.NavigateTo("/setup", replace: true);
            return;
        }

        _isLoading = false;
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
