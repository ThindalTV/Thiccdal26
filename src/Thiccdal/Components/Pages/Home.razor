@page "/"
@layout Thiccdal.Shared.Components.Layout.NullLayout
@inject NavigationManager Navigation

<PageTitle>Thiccdal</PageTitle>

@code {
    protected override void OnInitialized()
    {
        // The root has no surface of its own; configuration is the one place that always works.
        Navigation.NavigateTo("/config", replace: true);
    }
}
