@page "/settings/streaming"

@using Thiccdal.Components.Setup.Steps
@using Thiccdal.Infrastructure.Setup
@using Thiccdal.Infrastructure.Streaming

@inject IConfigurationPersistenceService ConfigService
@inject ILogger<StreamingSettings> Logger
@inject NavigationManager Navigation

<PageTitle>Streaming Settings - Thiccdal</PageTitle>

<div class="container py-4">
    <div class="row">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item active">Streaming Settings</li>
                </ol>
            </nav>

            <h2 class="mb-4">
                <span class="bi bi-broadcast me-2"></span>
                Streaming Settings
            </h2>

            @if (_loading)
            {
                <div class="d-flex justify-content-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <StreamingStep @ref="_streamingStep"
                                             OnValidationChanged="OnValidationChanged"
                                             OnDataChanged="OnDataChanged" />
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <button class="btn btn-outline-secondary" @onclick="Cancel">
                            <span class="bi bi-x-lg me-1"></span> Cancel
                        </button>
                        <button class="btn btn-primary" @onclick="Save" disabled="@(!_isValid || _saving)">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span class="bi bi-check-lg me-1"></span>
                                <span>Save Changes</span>
                            }
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="alert alert-success mt-3">
                        <span class="bi bi-check-circle me-2"></span>
                        @_successMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger mt-3">
                        <span class="bi bi-exclamation-triangle me-2"></span>
                        @_errorMessage
                    </div>
                }
            }
        </div>

        <div class="col-lg-4">
            <div class="card bg-body-tertiary">
                <div class="card-body">
                    <h6 class="card-title">
                        <span class="bi bi-info-circle me-1"></span>
                        About Streaming Settings
                    </h6>
                    <p class="card-text small text-muted">
                        Configure how Thiccdal receives and processes your stream from OBS.
                    </p>
                    <hr />
                    <h6 class="small fw-semibold">Deployment Modes</h6>
                    <ul class="small text-muted ps-3">
                        <li><strong>Embedded:</strong> RTMP server runs inside Thiccdal</li>
                        <li><strong>External:</strong> Separate RTMP server for better performance</li>
                    </ul>
                    <hr />
                    <h6 class="small fw-semibold">Restart Required</h6>
                    <p class="small text-muted mb-0">
                        Changes to deployment mode or ingest URL require a restart to take effect.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private StreamingStep? _streamingStep;
    private bool _loading = true;
    private bool _saving;
    private bool _isValid = true;
    private string? _successMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var data = await ConfigService.GetValue<StreamingStepData>("Streaming", CancellationToken.None);
            if (data is not null && _streamingStep is not null)
            {
                _streamingStep.LoadData(data);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load streaming settings.");
            _errorMessage = "Failed to load settings. Using defaults.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _streamingStep is not null)
        {
            var data = await ConfigService.GetValue<StreamingStepData>("Streaming", CancellationToken.None);
            if (data is not null)
            {
                _streamingStep.LoadData(data);
                StateHasChanged();
            }
        }
    }

    private void OnValidationChanged(bool isValid)
    {
        _isValid = isValid;
        _successMessage = null;
        StateHasChanged();
    }

    private void OnDataChanged(StreamingStepData data)
    {
        _successMessage = null;
        StateHasChanged();
    }

    private async Task Save()
    {
        if (_streamingStep is null || !_isValid)
        {
            return;
        }

        _saving = true;
        _errorMessage = null;
        _successMessage = null;
        StateHasChanged();

        try
        {
            var data = _streamingStep.GetData();
            await ConfigService.SetValue("Streaming", data, CancellationToken.None);
            _successMessage = "Streaming settings saved. Restart Thiccdal for changes to take effect.";
            _streamingStep.MarkSaved();
            Logger.LogInformation("Streaming settings saved.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save streaming settings.");
            _errorMessage = "Failed to save settings. Please try again.";
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/");
    }
}
