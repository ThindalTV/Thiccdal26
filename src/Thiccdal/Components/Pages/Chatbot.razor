@page "/chatbot"
@inject IChatterMemoryService ChatterMemoryService
@inject IOptions<ChatBotOptions> ChatBotOptionsAccessor

@using Microsoft.Extensions.Options
@using Thiccdal.Infrastructure.Bot
@using Thiccdal.Infrastructure.Bot.Models

<PageTitle>Chatbot</PageTitle>

<div class="container-fluid mt-4">
    <h1 class="mb-3">Chatbot</h1>
    <p class="text-muted mb-4">
        Mention-triggered AI replies stay on the originating platform and channel. Chatter memory remains scoped to
        <code>{platform, channel, user}</code>, uses public-chat facts only, and is enabled by default unless you turn it off in configuration.
    </p>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-success" role="status">@_statusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    <div class="row g-4">
        <div class="col-12 col-xl-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h4">Current memory behavior</h2>
                    <dl class="row mb-0">
                        <dt class="col-sm-5">AI replies enabled</dt>
                        <dd class="col-sm-7">@FormatEnabled(Options.AiResponder.Enabled)</dd>

                        <dt class="col-sm-5">Chatter memory enabled</dt>
                        <dd class="col-sm-7">@FormatEnabled(Options.AiResponder.ChatterMemoryEnabled)</dd>

                        <dt class="col-sm-5">Retention window</dt>
                        <dd class="col-sm-7">@GetRetentionDescription()</dd>

                        <dt class="col-sm-5">Reset behavior</dt>
                        <dd class="col-sm-7">Source chat history and platform events stay intact.</dd>

                        <dt class="col-sm-5">Config keys</dt>
                        <dd class="col-sm-7"><code>ChatBot:AiResponder:ChatterMemoryEnabled</code> and <code>ChatBot:AiResponder:ChatterMemoryRetentionDays</code></dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h4">Reset one chatter memory scope</h2>
                    <p class="text-muted">
                        Use this when you need to forget derived memory for one chatter on one platform and channel.
                        Resetting memory hides older derived context without deleting stored chat history.
                    </p>

                    <div class="mb-3">
                        <label class="form-label" for="chatbot-platform">Platform</label>
                        <select id="chatbot-platform" class="form-select" @bind="_scope.Source">
                            @foreach (PlatformEventSource source in Enum.GetValues<PlatformEventSource>())
                            {
                                <option value="@source">@source</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="chatbot-channel">Channel</label>
                        <input id="chatbot-channel" class="form-control" @bind="_scope.Channel" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="chatbot-platform-user-id">Platform user ID</label>
                        <input id="chatbot-platform-user-id" class="form-control" @bind="_scope.PlatformUserId" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="chatbot-requested-by">Requested by</label>
                        <input id="chatbot-requested-by" class="form-control" @bind="_requestedBy" />
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-warning" @onclick="ResetScope" disabled="@_isSubmitting">Reset chatter memory</button>
                        <button class="btn btn-outline-danger" @onclick="ResetAll" disabled="@_isSubmitting">Reset all chatter memory</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly ResetScopeModel _scope = new();
    private string _requestedBy = GetDefaultRequestedBy();
    private string? _statusMessage;
    private string? _errorMessage;
    private bool _isSubmitting;

    private ChatBotOptions Options => ChatBotOptionsAccessor.Value;

    private async Task ResetScope()
    {
        if (string.IsNullOrWhiteSpace(_scope.Channel) || string.IsNullOrWhiteSpace(_scope.PlatformUserId))
        {
            SetError("Platform, channel, and platform user ID are required to reset one chatter scope.");
            return;
        }

        await ExecuteReset(
            async cancellationToken =>
            {
                await ChatterMemoryService.Reset(
                    _scope.Source,
                    _scope.Channel.Trim(),
                    _scope.PlatformUserId.Trim(),
                    GetRequestedBy(),
                    cancellationToken);

                _statusMessage =
                    $"Reset chatter memory for {_scope.Source}/{_scope.Channel.Trim()}/{_scope.PlatformUserId.Trim()}. Source chat history and platform events stay intact.";
            });
    }

    private async Task ResetAll()
    {
        await ExecuteReset(
            async cancellationToken =>
            {
                await ChatterMemoryService.ResetAll(GetRequestedBy(), cancellationToken);
                _statusMessage = "Reset all chatter memory. Source chat history and platform events stay intact.";
            });
    }

    private async Task ExecuteReset(Func<CancellationToken, Task> action)
    {
        _isSubmitting = true;
        _statusMessage = null;
        _errorMessage = null;

        try
        {
            await action(CancellationToken.None);
        }
        catch (Exception exception)
        {
            _errorMessage = $"Chatbot memory reset failed: {exception.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private string GetRetentionDescription()
    {
        return Options.AiResponder.ChatterMemoryRetentionDays is int retentionDays
            ? $"{retentionDays} day(s)"
            : "No automatic cutoff configured";
    }

    private string GetRequestedBy()
    {
        return string.IsNullOrWhiteSpace(_requestedBy) ? "operator" : _requestedBy.Trim();
    }

    private void SetError(string message)
    {
        _statusMessage = null;
        _errorMessage = message;
    }

    private static string FormatEnabled(bool isEnabled)
    {
        return isEnabled ? "Yes" : "No";
    }

    private static string GetDefaultRequestedBy()
    {
        return string.IsNullOrWhiteSpace(Environment.UserName) ? "operator" : Environment.UserName;
    }

    private sealed class ResetScopeModel
    {
        public PlatformEventSource Source { get; set; } = PlatformEventSource.Twitch;

        public string Channel { get; set; } = string.Empty;

        public string PlatformUserId { get; set; } = string.Empty;
    }
}
