@page "/twitch/connect"
@inject NavigationManager Navigation

@using Thiccdal.Infrastructure.Twitch

@*
    Legacy redirect shim for /twitch/connect
    This page now redirects to /integrations where Twitch setup is handled via TwitchSetupDialog.
    OAuth error query params are preserved.
*@

<PageTitle>Redirecting to Integrations</PageTitle>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? CallbackError { get; set; }

    protected override void OnInitialized()
    {
        var targetUrl = string.IsNullOrWhiteSpace(CallbackError)
            ? "/integrations"
            : $"/integrations?error={Uri.EscapeDataString(CallbackError)}";
        
        Navigation.NavigateTo(targetUrl, replace: true);
    }
}
