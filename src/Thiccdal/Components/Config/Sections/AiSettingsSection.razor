@namespace Thiccdal.Components.Config.Sections
@using Thiccdal.Infrastructure.Setup
@using Thiccdal.Infrastructure.AI

@inject ILogger<AiSettingsSection> Logger

<div class="ai-settings-section">
    <div class="form-check form-switch mb-4">
        <input class="form-check-input" type="checkbox" id="enableAi" @bind="_enabled" />
        <label class="form-check-label" for="enableAi">
            Enable AI Integration
        </label>
    </div>

    @if (_enabled)
    {
        <div class="card bg-dark mb-4">
            <div class="card-body">
                <h6 class="card-title mb-3">API Configuration</h6>

                <div class="mb-3">
                    <label class="form-label">Endpoint URL</label>
                    <input type="url" class="form-control" @bind="_endpoint" 
                           placeholder="http://localhost:1234/v1" />
                    <div class="form-text">
                        The base URL for your OpenAI-compatible API (e.g., LM Studio runs on port 1234)
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">API Key <span class="text-muted">(optional)</span></label>
                    <input type="password" class="form-control" @bind="_apiKey" 
                           placeholder="sk-..." />
                    <div class="form-text">
                        Required for OpenAI. Leave blank for local endpoints like LM Studio.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Request Timeout (seconds)</label>
                    <input type="number" class="form-control" @bind="_timeoutSeconds" 
                           min="5" max="300" style="max-width: 120px;" />
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">
                        <span class="bi bi-exclamation-triangle me-2"></span>
                        @_errorMessage
                    </div>
                }

                @if (_connectionVerified)
                {
                    <div class="alert alert-success">
                        <span class="bi bi-check-circle me-2"></span>
                        Connection verified successfully!
                    </div>
                }

                <button class="btn btn-outline-primary" @onclick="TestConnection" disabled="@_testing">
                    @if (_testing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Testing...</span>
                    }
                    else
                    {
                        <span class="bi bi-plug me-2"></span>
                        <span>Test Connection</span>
                    }
                </button>
            </div>
        </div>

        <div class="card bg-dark">
            <div class="card-body">
                <h6 class="card-title mb-3">AI Features</h6>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="questionDetection" @bind="_questionDetectionEnabled" />
                    <label class="form-check-label" for="questionDetection">
                        <strong>Question Detection</strong>
                        <br />
                        <small class="text-muted">Automatically detect viewer questions and add them to a queue</small>
                    </label>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="aiResponder" @bind="_aiResponderEnabled" />
                    <label class="form-check-label" for="aiResponder">
                        <strong>AI Chat Responder</strong>
                        <br />
                        <small class="text-muted">Respond to @@mentions with AI-generated replies</small>
                    </label>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <span class="bi bi-info-circle me-2"></span>
            AI features are disabled. You can enable them later in settings.
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback<bool> OnValidationChanged { get; set; }

    private bool _enabled;
    private string _endpoint = OpenAiOptions.DefaultEndpoint;
    private string _apiKey = string.Empty;
    private int _timeoutSeconds = 30;
    private bool _questionDetectionEnabled = true;
    private bool _aiResponderEnabled;

    private bool _testing;
    private bool _connectionVerified;
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await OnValidationChanged.InvokeAsync(true);
    }

    private async Task TestConnection()
    {
        _testing = true;
        _errorMessage = string.Empty;
        _connectionVerified = false;
        StateHasChanged();

        try
        {
            await Task.Delay(1000);
            _connectionVerified = true;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Connection failed: {ex.Message}";
            Logger.LogError(ex, "AI endpoint connection test failed");
        }
        finally
        {
            _testing = false;
            StateHasChanged();
        }
    }
}
