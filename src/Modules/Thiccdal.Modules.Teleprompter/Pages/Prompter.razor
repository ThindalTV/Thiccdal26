@page "/prompter"
@using Thiccdal.Infrastructure.Bot
@using Thiccdal.Infrastructure.Bot.Models
@using Thiccdal.Infrastructure.Operators
@using Thiccdal.Infrastructure.Questions
@using Thiccdal.Infrastructure.Remotes
@using Thiccdal.Infrastructure.Sponsors
@using Thiccdal.Infrastructure.Twitch
@using Microsoft.JSInterop
@using Thiccdal.Modules.Teleprompter.Components
@using Thiccdal.Modules.Teleprompter.Models
@using Thiccdal.Shared.Components.Components.Readiness
@layout Thiccdal.Shared.Components.Layout.NullLayout

@implements IAsyncDisposable

@inject IActivityFeedService ActivityFeedService
@inject IChatService ChatService
@inject IEventBus EventBus
@inject IJSRuntime JS
@inject IOperatorStateService OperatorStateService
@inject IQuestionOverlayService QuestionOverlayService
@inject IEnumerable<IPlatformConnection> PlatformConnections
@inject ITwitchTargetChannelService TargetChannelService

<ReadinessGate SurfaceName="The teleprompter" Requires="ReadinessRequirement.ChannelConfigured">
    <div id="prompterBackground">
        @if (_showQuestionFlash)
        {
            <div class="prompter-flash prompter-flash--question"></div>
            <div class="prompter-attention" role="status" aria-live="polite" aria-atomic="true">
                <span class="prompter-attention__dot"></span>
                <span>New question ready</span>
            </div>
        }

        @if (_showEventFlash)
        {
            <div class="prompter-flash prompter-flash--event"></div>
        }

        <SponsorBar />

        <div class="prompter-content">
            <div id="chatList">
                @foreach (var line in _lines)
                {
                    <PrompterLine Line="@line" />
                }
            </div>
        </div>
    </div>
</ReadinessGate>

@code {
    private readonly CancellationTokenSource _cts = new();
    private List<Line> _lines = [];

    private int _scrollPosition;
    private bool _showEventFlash;
    private bool _showQuestionFlash;
    private int _eventFlashVersion;
    private int _questionFlashVersion;
    private long _lastQuestionAttentionSequence;
    private Task? _significantEventSubscriptionTask;
    private Task? _connectionPollTask;
    private string _channelName = string.Empty;
    private PlatformConnectionState _connectionState = PlatformConnectionState.Disconnected;

    protected override async Task OnInitializedAsync()
    {
        ActivityFeedService.EntryAdded += HandleEntryAdded;
        OperatorStateService.StateChanged += HandleOperatorStateChanged;
        _lines = ActivityFeedService
            .GetEntries()
            .Select(CreateLine)
            .ToList();
        _lastQuestionAttentionSequence = QuestionOverlayService.GetState().AttentionSequence;
        _scrollPosition = OperatorStateService.TeleprompterScrollPosition;
        if (_lastQuestionAttentionSequence > 0)
        {
            ShowQuestionFlash();
        }

        TargetChannelService.ConnectionProfileChanged += HandleConnectionProfileChanged;
        TwitchChatConnectionProfile profile = await TargetChannelService.GetConnectionProfile(_cts.Token);
        _channelName = profile.TargetChannel;
        _connectionState = GetPlatformConnectionState();
        AddStatusLine(_connectionState);

        await ChatService.Connect(_cts.Token);
        _significantEventSubscriptionTask = ListenForSignificantEvents(_cts.Token);
        _connectionPollTask = PollConnectionState(_cts.Token);

        await base.OnInitializedAsync();
    }

    private void HandleEntryAdded(object? sender, ActivityFeedEntry entry)
    {
        _lines.Insert(0, CreateLine(entry));
        TrimLines();
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        ActivityFeedService.EntryAdded -= HandleEntryAdded;
        OperatorStateService.StateChanged -= HandleOperatorStateChanged;
        TargetChannelService.ConnectionProfileChanged -= HandleConnectionProfileChanged;
        _cts.Cancel();

        foreach (Task? backgroundTask in new[] { _significantEventSubscriptionTask, _connectionPollTask })
        {
            if (backgroundTask is null)
            {
                continue;
            }

            try
            {
                await backgroundTask;
            }
            catch (OperationCanceledException) when (_cts.IsCancellationRequested)
            {
            }
        }

        _cts.Dispose();
    }

    private void TrimLines()
    {
        if (_lines.Count > 150)
        {
            _lines.RemoveRange(150, _lines.Count - 150);
        }
    }

    private static Line CreateLine(ActivityFeedEntry entry)
    {
        return new Line(
            entry.Sender,
            entry.Content,
            entry.HtmlContent,
            entry.Source.ToString(),
            entry.Timestamp,
            entry.Type,
            AccentColor: string.IsNullOrWhiteSpace(entry.AccentColor) ? null : entry.AccentColor,
            SenderColor: string.IsNullOrWhiteSpace(entry.SenderColor) ? null : entry.SenderColor,
            Badges: entry.Badges,
            Parts: entry.Parts);
    }

    private void HandleOperatorStateChanged(object? sender, EventArgs args)
    {
        long questionAttentionSequence = QuestionOverlayService.GetState().AttentionSequence;
        if (questionAttentionSequence > _lastQuestionAttentionSequence)
        {
            ShowQuestionFlash();
        }

        _lastQuestionAttentionSequence = questionAttentionSequence;
        _scrollPosition = OperatorStateService.TeleprompterScrollPosition;
        _ = InvokeAsync(async () =>
        {
            await ApplyScrollPosition();
            StateHasChanged();
        });
    }

    private async Task ListenForSignificantEvents(CancellationToken cancellationToken)
    {
        try
        {
            await foreach (PlatformEvent platformEvent in EventBus.Subscribe(cancellationToken))
            {
                if (ShouldTriggerEventFlash(platformEvent))
                {
                    await TriggerEventFlash();
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private static bool ShouldTriggerEventFlash(PlatformEvent platformEvent) => platformEvent.Type switch
    {
        PlatformEventType.ChatMessage => false,
        PlatformEventType.Raw => false,
        _ => true
    };

    private void ShowQuestionFlash()
    {
        int flashVersion = Interlocked.Increment(ref _questionFlashVersion);
        _showQuestionFlash = true;
        _ = InvokeAsync(StateHasChanged);
        _ = HideQuestionFlash(flashVersion);
    }

    private async Task HideQuestionFlash(int flashVersion)
    {
        try
        {
            await Task.Delay(600, _cts.Token);

            if (flashVersion == _questionFlashVersion && !_cts.IsCancellationRequested)
            {
                _showQuestionFlash = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
    }

    private async Task TriggerEventFlash()
    {
        try
        {
            int flashVersion = Interlocked.Increment(ref _eventFlashVersion);
            _showEventFlash = true;
            await InvokeAsync(StateHasChanged);

            // Matches the 1s in-and-out prompter-flash-event animation.
            await Task.Delay(1000, _cts.Token);

            if (flashVersion == _eventFlashVersion && !_cts.IsCancellationRequested)
            {
                _showEventFlash = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyScrollPosition();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private void HandleConnectionProfileChanged(object? sender, TwitchChatConnectionProfile profile)
    {
        _channelName = profile.TargetChannel;
    }

    private void AddStatusLine(PlatformConnectionState state)
    {
        string channel = string.IsNullOrWhiteSpace(_channelName) ? "Twitch" : _channelName;
        string content = state switch
        {
            PlatformConnectionState.Connected => $"Connected to {channel}",
            PlatformConnectionState.Connecting => $"Connecting to {channel}",
            _ => $"Not connected to {channel}"
        };
        string accentColor = state switch
        {
            PlatformConnectionState.Connected => "#3CC864",
            PlatformConnectionState.Connecting => "#F59E0B",
            _ => "#F87171"
        };

        _lines.Insert(
            0,
            new Line(
                "Thiccdal",
                content,
                content,
                "Thiccdal",
                DateTime.UtcNow,
                PlatformEventType.Raw,
                AccentColor: accentColor,
                IsStatus: true));
        TrimLines();
    }

    // Platform adapters expose connection state as a property, not as an event, so the on-camera
    // status indicator is refreshed on a slow poll rather than pushed.
    private async Task PollConnectionState(CancellationToken cancellationToken)
    {
        try
        {
            using PeriodicTimer timer = new PeriodicTimer(TimeSpan.FromSeconds(5));

            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                PlatformConnectionState state = GetPlatformConnectionState();
                if (state == _connectionState)
                {
                    continue;
                }

                _connectionState = state;
                AddStatusLine(state);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private PlatformConnectionState GetPlatformConnectionState()
    {
        PlatformConnectionState[] states = PlatformConnections
            .Select(connection => connection.State)
            .ToArray();

        if (states.Contains(PlatformConnectionState.Connected))
        {
            return PlatformConnectionState.Connected;
        }

        if (states.Contains(PlatformConnectionState.Connecting))
        {
            return PlatformConnectionState.Connecting;
        }

        return states.Contains(PlatformConnectionState.Error)
            ? PlatformConnectionState.Error
            : PlatformConnectionState.Disconnected;
    }

    private async Task ApplyScrollPosition()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollPrompter", _scrollPosition);
        }
        catch (InvalidOperationException)
        {
        }
    }
}
