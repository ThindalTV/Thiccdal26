@using Microsoft.AspNetCore.Components
@using Thiccdal.Modules.Teleprompter.Models

@if (!string.IsNullOrWhiteSpace(Line.HtmlContent))
{
    <div class="message">@((MarkupString)Line.HtmlContent)</div>
}
else
{
    <div class="message">@Line.Content</div>
}

@code {
    [Parameter] public required Line Line { get; set; }
}
