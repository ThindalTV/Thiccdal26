@using Thiccdal.Modules.Teleprompter.Models
@using Thiccdal.Infrastructure.Bot.Models

<div class="@GetLineCssClass()" style="@GetAccentStyle()">
    <div class="platform">
        @if (!Line.IsStatus)
        {
            @switch (Line.Platform)
            {
                case "Twitch":
                    <img src="/img/platforms/twitch.svg" />
                    break;
                default:
                    <span class="bi bi-question-circle"></span>
                    break;
            }
        }
    </div>
    <time>@Line.Timestamp.ToLocalTime().ToString("HH:mm:ss")</time>
    <div class="badges">
        @foreach (string badgeLabel in GetBadgeLabels())
        {
            <span class="badge-pill">@badgeLabel</span>
        }
    </div>
    <div class="sender" style="@GetSenderStyle()">@GetSenderName()</div>
    <div class="promptContent">
        @if (IsChatLine)
        {
            <ChatLine Line="@Line" />
        }
        else
        {
            <div class="activity">@Line.Content</div>
        }
    </div>
</div>
@code {
    [Parameter]
    public required Line Line { get; set; }

    private bool IsChatLine => !Line.IsStatus && Line.Type == PlatformEventType.ChatMessage;

    // Chat names the chatter, events name whoever set them off, and what the app raises itself says so.
    private string GetSenderName()
    {
        return string.IsNullOrWhiteSpace(Line.Sender) ? "system" : Line.Sender;
    }

    private string GetLineCssClass()
    {
        if (Line.IsStatus)
        {
            return "line line--activity line--status";
        }

        return Line.Type == PlatformEventType.ChatMessage
            ? "line"
            : "line line--activity";
    }

    private string? GetAccentStyle()
    {
        return string.IsNullOrWhiteSpace(Line.AccentColor)
            ? null
            : $"--line-accent: {Line.AccentColor};";
    }

    private string? GetSenderStyle()
    {
        return string.IsNullOrWhiteSpace(Line.SenderColor)
            ? null
            : $"color: {Line.SenderColor};";
    }

    private IEnumerable<string> GetBadgeLabels()
    {
        if (Line.Badges is null)
        {
            return [];
        }

        return Line.Badges
            .Select(GetBadgeLabel)
            .Where(static label => !string.IsNullOrEmpty(label))
            .Distinct(StringComparer.Ordinal)
            .ToArray();
    }

    // Twitch badge set ids. Another platform means another vocabulary — a YouTube subscription is a
    // Twitch follow, not a Twitch subscription — so its adapter supplies its own set ids and falls through.
    private static string GetBadgeLabel(ChatBadge badge) => badge.SetId switch
    {
        // The operator knows which channel they are reading; naming them adds nothing on camera.
        "broadcaster" => string.Empty,
        "subscriber" or "founder" => "SUB",
        "moderator" => "MOD",
        "vip" => "VIP",
        _ => badge.SetId
    };
}
