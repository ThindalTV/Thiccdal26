@using Thiccdal.Modules.Teleprompter.Models
@using Thiccdal.Infrastructure.Bot.Models

<div class="@GetLineCssClass()" style="@GetAccentStyle()">
    <div class="platform">
        @if (!Line.IsStatus)
        {
            @switch (Line.Platform)
            {
                case "Twitch":
                    <img src="/img/platforms/twitch.svg" />
                    break;
                default:
                    <span class="bi bi-question-circle"></span>
                    break;
            }
        }
    </div>
    <time>@Line.Timestamp.ToLocalTime().ToString("HH:mm:ss")</time>
    <div class="sender">
        @if (Line.IsStatus)
        {
            <span class="event-pill">STATUS</span>
        }
        else if (Line.Type != PlatformEventType.ChatMessage && Line.Type != PlatformEventType.Raw)
        {
            <span class="event-pill">@Line.Type.ToString().ToUpperInvariant()</span>
        }

        @if (Line.Badges is { Count: > 0 })
        {
            foreach (ChatBadge badge in Line.Badges)
            {
                <span class="badge-pill">@FormatBadge(badge)</span>
            }
        }

        <span class="sender__name" style="@GetSenderStyle()">@Line.Sender</span>
    </div>
    <div class="promptContent">
        @if (!Line.IsStatus && Line.Type == PlatformEventType.ChatMessage)
        {
            <ChatLine Line="@Line" />
        }
        else
        {
            <div class="activity">@Line.Content</div>
        }
    </div>
</div>
@code {
    [Parameter]
    public required Line Line { get; set; }

    private string GetLineCssClass()
    {
        if (Line.IsStatus)
        {
            return "line line--activity line--status";
        }

        return Line.Type == PlatformEventType.ChatMessage
            ? "line"
            : "line line--activity";
    }

    private string? GetAccentStyle()
    {
        return string.IsNullOrWhiteSpace(Line.AccentColor)
            ? null
            : $"--line-accent: {Line.AccentColor};";
    }

    private string? GetSenderStyle()
    {
        return string.IsNullOrWhiteSpace(Line.SenderColor)
            ? null
            : $"color: {Line.SenderColor};";
    }

    private static string FormatBadge(ChatBadge badge)
    {
        return string.IsNullOrWhiteSpace(badge.Version)
            ? badge.SetId
            : $"{badge.SetId}:{badge.Version}";
    }
}
