@using Thiccdal.Infrastructure.Sponsors
@implements IAsyncDisposable

@inject ISponsorshipService SponsorshipService

@if (SponsorshipService.Config?.HasSponsor == true)
{
    <div class="sponsor-bar sponsor-bar--@GetStateClass()">
        @if (_readState == SponsorReadState.ReadActive)
        {
            <div class="sponsor-bar__script">
                <span class="sponsor-bar__script-label">SPONSOR READ</span>
                <p class="sponsor-bar__script-text">@(SponsorshipService.Config?.Script)</p>
            </div>
            <div class="sponsor-bar__actions">
                <button type="button" class="sponsor-bar__btn sponsor-bar__btn--end" @onclick="EndRead">End Read</button>
            </div>
        }
        else
        {
            <div class="sponsor-bar__info">
                @if (_readState == SponsorReadState.ReadDue)
                {
                    <span class="sponsor-bar__due-label">&#x26A1; SPONSOR READ DUE</span>
                }
                else
                {
                    <span class="sponsor-bar__countdown">Next read in: @GetCountdownText()</span>
                }
            </div>
            <div class="sponsor-bar__actions">
                <button type="button" class="sponsor-bar__btn sponsor-bar__btn--start" @onclick="StartRead">Start Read</button>
                @if (_readState == SponsorReadState.ReadDue)
                {
                    <button type="button" class="sponsor-bar__btn sponsor-bar__btn--skip" @onclick="SkipRead">Skip</button>
                }
                <button type="button" class="sponsor-bar__btn sponsor-bar__btn--reset" @onclick="EndRead">Reset</button>
            </div>
        }
    </div>
}

@code {
    private SponsorReadState _readState;
    private CancellationTokenSource _cts = new CancellationTokenSource();
    private Task? _countdownTask;

    protected override void OnInitialized()
    {
        _readState = SponsorshipService.ReadState;
        SponsorshipService.StateChanged += HandleStateChanged;
        _countdownTask = RunCountdownRefresh(_cts.Token);
    }

    private async Task RunCountdownRefresh(CancellationToken cancellationToken)
    {
        using PeriodicTimer timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        while (!cancellationToken.IsCancellationRequested && await timer.WaitForNextTickAsync(cancellationToken))
        {
            if (_readState == SponsorReadState.Idle && SponsorshipService.NextReadAt.HasValue)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void StartRead()
    {
        SponsorshipService.StartRead();
    }

    private void EndRead()
    {
        SponsorshipService.EndRead();
    }

    private void SkipRead()
    {
        SponsorshipService.SkipRead();
    }

    private void HandleStateChanged(object? sender, EventArgs e)
    {
        _readState = SponsorshipService.ReadState;
        _ = InvokeAsync(StateHasChanged);
    }

    private string GetStateClass() => _readState switch
    {
        SponsorReadState.ReadDue => "due",
        SponsorReadState.ReadActive => "active",
        _ => "idle"
    };

    private string GetCountdownText()
    {
        DateTimeOffset? nextReadAt = SponsorshipService.NextReadAt;
        if (!nextReadAt.HasValue) return "--:--";
        TimeSpan remaining = nextReadAt.Value - DateTimeOffset.UtcNow;
        if (remaining <= TimeSpan.Zero) return "00:00";
        return remaining.ToString(@"mm\:ss");
    }

    public async ValueTask DisposeAsync()
    {
        SponsorshipService.StateChanged -= HandleStateChanged;
        await _cts.CancelAsync();
        if (_countdownTask is not null)
        {
            try { await _countdownTask; }
            catch (OperationCanceledException) { }
        }
        _cts.Dispose();
    }
}
