@using Thiccdal.Infrastructure.Overlay

@inherits TestableOverlayComponentBase
@implements IDisposable
@inject ILowerThirdService LowerThirdService

@if (_renderedContent is not null || IsTestFlashing)
{
    <div class="lower-third-overlay-host">
        @if (_renderedContent is LowerThirdContent content)
        {
            <div class="lower-third-overlay @GetAccentClass(content) @_animationClass" style="@GetAccentStyle(content)">
                <div class="lower-third-overlay__meta">@content.Eyebrow</div>
                <div class="lower-third-overlay__text">@Truncate(content.Text)</div>
            </div>
        }

        @if (IsTestFlashing)
        {
            <div class="test-flash-overlay">
                <span class="test-flash-label">@TestFlashLabel</span>
            </div>
        }
    </div>
}

@code {
    private CancellationTokenSource? _transitionCancellationTokenSource;
    private LowerThirdContent? _renderedContent;
    private string _animationClass = string.Empty;

    public override string ComponentName => "Lower Third";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _renderedContent = LowerThirdService.GetCurrent();
        _animationClass = _renderedContent is null ? string.Empty : "lower-third-overlay--enter";
        LowerThirdService.StateChanged += HandleLowerThirdChanged;
    }

    public override void Dispose()
    {
        LowerThirdService.StateChanged -= HandleLowerThirdChanged;
        _transitionCancellationTokenSource?.Cancel();
        _transitionCancellationTokenSource?.Dispose();
        base.Dispose();
    }

    private void HandleLowerThirdChanged(object? sender, EventArgs args)
    {
        _transitionCancellationTokenSource?.Cancel();
        _transitionCancellationTokenSource?.Dispose();
        _transitionCancellationTokenSource = new CancellationTokenSource();
        _ = InvokeAsync(() => SynchronizeContent(_transitionCancellationTokenSource.Token));
    }

    private async Task SynchronizeContent(CancellationToken cancellationToken)
    {
        try
        {
            LowerThirdContent? nextContent = LowerThirdService.GetCurrent();

            if (Matches(_renderedContent, nextContent))
            {
                return;
            }

            if (_renderedContent is not null)
            {
                _animationClass = "lower-third-overlay--exit";
                await InvokeAsync(StateHasChanged);
                await Task.Delay(300, cancellationToken);
            }

            _renderedContent = nextContent;
            _animationClass = _renderedContent is null ? string.Empty : "lower-third-overlay--enter";
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private static bool Matches(LowerThirdContent? current, LowerThirdContent? next)
    {
        if (current is null || next is null)
        {
            return current is null && next is null;
        }

        return current.QuestionId == next.QuestionId
            && string.Equals(current.Text, next.Text, StringComparison.Ordinal)
            && string.Equals(current.Eyebrow, next.Eyebrow, StringComparison.Ordinal);
    }

    private static string Truncate(string text)
    {
        if (string.IsNullOrWhiteSpace(text) || text.Length <= 120)
        {
            return text;
        }

        return $"{text[..119].TrimEnd()}…";
    }

    private static string GetAccentClass(LowerThirdContent content)
    {
        // Card accents arrive as CSS colours and are applied inline instead of through a class.
        if (content.Accent.StartsWith('#'))
        {
            return "lower-third-overlay--card";
        }

        return content.Accent.Trim().ToUpperInvariant() switch
        {
            "PENDING" or "TWITCH" => "lower-third-overlay--twitch",
            "MANUAL" => "lower-third-overlay--manual",
            _ => "lower-third-overlay--default"
        };
    }

    private static string? GetAccentStyle(LowerThirdContent content)
    {
        return content.Accent.StartsWith('#') ? $"--platform-accent: {content.Accent}" : null;
    }
}
