@using Thiccdal.Infrastructure.Twitch
@implements IDisposable
@inject ITwitchStreamInfoService TwitchStreamInfoService

<header class="topbar topbar--live">
    <div class="topbar__left">
        <span class="topbar__brand">THICCDAL</span>
        <StreamStatusBadge />
        <div class="topbar__connections">
            <PlatformConnectionBadges />
        </div>
    </div>

    <div class="topbar__right">
        @if (_twitchStreamState?.IsLive == true)
        {
            <span class="topbar__viewer-count">
                <span class="topbar__viewer-count-icon" aria-hidden="true">👁</span>
                @_twitchStreamState.ViewerCount.ToString("N0")
            </span>
        }
    </div>
</header>

@code {
    private TwitchStreamState? _twitchStreamState;

    protected override void OnInitialized()
    {
        _twitchStreamState = TwitchStreamInfoService.CurrentState;
        TwitchStreamInfoService.StreamStateChanged += HandleStreamStateChanged;
    }

    public void Dispose()
    {
        TwitchStreamInfoService.StreamStateChanged -= HandleStreamStateChanged;
    }

    private void HandleStreamStateChanged(object? sender, TwitchStreamState? state)
    {
        _twitchStreamState = state;
        _ = InvokeAsync(StateHasChanged);
    }
}
