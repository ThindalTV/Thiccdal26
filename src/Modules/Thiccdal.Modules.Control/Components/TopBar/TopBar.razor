@using Thiccdal.Shared.Components.Components.Primitives
@using Thiccdal.Modules.Control.Components.Integrations
@using Thiccdal.Infrastructure.Twitch
@inject ITwitchService TwitchService
@inject ITwitchTokenManager TwitchTokenManager
@implements IAsyncDisposable

<header class="topbar">
    <div class="topbar__left">
        <span class="topbar__brand">THICCDAL</span>
        <div class="topbar__platforms">
            <IntegrationConnector PlatformName="Twitch"
                                  ShortName="TWI"
                                  Color="#9146FF"
                                  ConnectionState="_twitchState"
                                  OnConnectClicked="OpenTwitchDialog" />
            <PlatformIndicator Platform="YT" ViewerCount="312" Color="#FF4444" IsLive="true" />
            <PlatformIndicator Platform="KICK" Color="#53FC18" IsLive="false" />
        </div>
    </div>

    <div class="topbar__restream">
        <div class="topbar__restream-dest" style="--plat-color: #9146FF">
            <span class="topbar__restream-name">Twitch</span>
            <span class="topbar__restream-stats">6,008 Kbps · 60fps</span>
            <button type="button" class="topbar__restream-btn topbar__restream-btn--stop">■ Stop</button>
            <span class="topbar__restream-dot"></span>
        </div>
        <div class="topbar__restream-dest" style="--plat-color: #FF4444">
            <span class="topbar__restream-name">YouTube</span>
            <span class="topbar__restream-stats">4,500 Kbps · 80fps</span>
            <button type="button" class="topbar__restream-btn topbar__restream-btn--stop">■ Stop</button>
            <span class="topbar__restream-dot"></span>
        </div>
        <div class="topbar__restream-dest" style="--plat-color: #53FC18">
            <span class="topbar__restream-name">Kick</span>
            <span class="topbar__restream-stats">idle</span>
            <button type="button" class="topbar__restream-btn topbar__restream-btn--go">▶ Go Live</button>
        </div>
    </div>

    <div class="topbar__right">
        <span class="topbar__timer">02:14:38</span>
        <div class="topbar__actions">
            <GhostButton>⚙ Config</GhostButton>
            <DangerButton>■ End</DangerButton>
        </div>
    </div>
</header>

<IntegrationAuthDialog PlatformName="Twitch"
                       Color="#9146FF"
                       AuthorizationUrl="@TwitchTokenManager.GetAuthorizationUrl()"
                       IsOpen="_twitchDialogOpen"
                       ErrorMessage="@_twitchAuthError"
                       OnClose="CloseTwitchDialog"
                       OnConnected="HandleTwitchConnected" />

@code {
    private IntegrationConnectionState _twitchState = IntegrationConnectionState.Unknown;
    private bool _twitchDialogOpen;
    private string? _twitchAuthError;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        TwitchService.ConnectionStateChanged += OnTwitchStateChanged;
        await TwitchService.RefreshConnectionState(_cts.Token);
        _twitchState = MapTwitchState(TwitchService.ConnectionState);
    }

    private void OnTwitchStateChanged(object? sender, TwitchConnectionState state)
    {
        _twitchState = MapTwitchState(state);
        InvokeAsync(StateHasChanged);
    }

    private static IntegrationConnectionState MapTwitchState(TwitchConnectionState state) => state switch
    {
        TwitchConnectionState.Connected => IntegrationConnectionState.Connected,
        TwitchConnectionState.Connecting => IntegrationConnectionState.Connecting,
        TwitchConnectionState.Authorized or TwitchConnectionState.Disconnected => IntegrationConnectionState.NotConnected,
        TwitchConnectionState.NotAuthorized => IntegrationConnectionState.NotConnected,
        TwitchConnectionState.Error => IntegrationConnectionState.Error,
        _ => IntegrationConnectionState.Unknown
    };

    private void OpenTwitchDialog()
    {
        _twitchAuthError = null;
        _twitchDialogOpen = true;
    }

    private void CloseTwitchDialog()
    {
        _twitchDialogOpen = false;
    }

    private async Task HandleTwitchConnected()
    {
        _twitchDialogOpen = false;
        await TwitchService.RefreshConnectionState(_cts.Token);
    }

    public async ValueTask DisposeAsync()
    {
        TwitchService.ConnectionStateChanged -= OnTwitchStateChanged;
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}