@using Thiccdal.Infrastructure.Streaming
@inject IRestreamControlClient RestreamControlClient

<div class="ctrl-panel restream-panel">
    <div class="ctrl-panel__header restream-panel__header">
        <div>
            <span class="ctrl-panel__title">Restream</span>
            <p class="restream-panel__summary">@GetRuntimeSummary()</p>
        </div>

        <div class="restream-panel__actions">
            <button type="button"
                    class="restream-panel__refresh"
                    disabled="@_isWorking"
                    @onclick="RefreshState">
                Refresh
            </button>
            <button type="button"
                    class="restream-panel__runtime-button @GetRuntimeButtonCssClass()"
                    disabled="@(!_hasState || _isWorking || (!_state!.IsFanoutRunning && !_state.CanStart))"
                    @onclick="ToggleRuntime">
                @GetRuntimeButtonText()
            </button>
        </div>
    </div>

    <div class="ctrl-panel__body restream-panel__body">
        <p class="restream-panel__intro">
            Choose which connected integrations join RTMP fanout from Thiccdal. Start and stop are API-backed here, while endpoint and stream-key provisioning still lives inside each platform integration until the relay host is complete.
        </p>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="restream-panel__message restream-panel__message--error" role="alert">@_errorMessage</div>
        }
        else if (_hasState && !string.IsNullOrWhiteSpace(_state!.OperatorMessage))
        {
            <div class="restream-panel__message" role="status">@_state.OperatorMessage</div>
        }

        @if (!_hasState)
        {
            <div class="restream-panel__empty">Loading restream state…</div>
        }
        else
        {
            <div class="restream-panel__configuration" aria-label="Restream configuration">
                <label class="restream-panel__field">
                    <span class="restream-panel__field-label">RTMP ingest URL</span>
                    <input class="form-control"
                           inputmode="url"
                           autocomplete="off"
                           @bind="_ingestUrl" />
                </label>

                <label class="restream-panel__field">
                    <span class="restream-panel__field-label">Recording folder</span>
                    <input class="form-control"
                           autocomplete="off"
                           @bind="_recordingOutputPath" />
                </label>

                <label class="restream-panel__field" style="grid-column: 1 / -1;">
                    <span class="restream-panel__field-label">BRB slate path</span>
                    <input class="form-control"
                           autocomplete="off"
                           @bind="_brbSlatePath" />
                </label>

                <label class="restream-panel__toggle">
                    <input type="checkbox" @bind="_startWithHost" />
                    <span>Start restream runtime automatically when Thiccdal is launched by Aspire.</span>
                </label>

                <button type="button"
                        class="restream-panel__save"
                        disabled="@_isWorking"
                        @onclick="SaveConfiguration">
                    Save configuration
                </button>
            </div>

            <div class="restream-panel__metrics" aria-label="Restream summary">
                <div class="restream-panel__metric">
                    <span class="restream-panel__metric-label">Enabled</span>
                    <span class="restream-panel__metric-value">@CurrentState.EnabledDestinationCount</span>
                </div>
                <div class="restream-panel__metric">
                    <span class="restream-panel__metric-label">Connected</span>
                    <span class="restream-panel__metric-value">@CurrentState.ConnectedDestinationCount</span>
                </div>
                <div class="restream-panel__metric">
                    <span class="restream-panel__metric-label">Ready now</span>
                    <span class="restream-panel__metric-value">@CurrentState.ActiveDestinationCount</span>
                </div>
            </div>

            <div class="restream-panel__destinations">
                @foreach (RestreamDestinationState destination in CurrentState.Destinations)
                {
                    <RestreamDestination PlatformName="@destination.PlatformName"
                                         PlatformColor="@ResolvePlatformColor(destination.PlatformName)"
                                         PrimaryText="@GetPrimaryText(destination)"
                                         SecondaryText="@GetSecondaryText(destination)"
                                         ActionText="@(destination.IsEnabled ? "Disable" : "Enable")"
                                         IsSelected="@destination.IsEnabled"
                                         IsDangerAction="@destination.IsEnabled"
                                         IsActionDisabled="@_isWorking"
                                         ShowStatusPulse="@(CurrentState.IsFanoutRunning && destination.IsEnabled && destination.IsConnected)"
                                         OnAction="() => ToggleDestination(destination)" />
                }
            </div>

            <p class="restream-panel__note">
                @CurrentState.DependencyNote
                @if (CurrentState.IsBrbSlateConfigured)
                {
                    <span> BRB slate path saved for the later FFmpeg recovery step.</span>
                }
            </p>
        }
    </div>
</div>

@code {
    private static readonly IReadOnlyDictionary<string, string> PlatformColors = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Discord"] = "#5865F2",
        ["Facebook"] = "#1877F2",
        ["LinkedIn"] = "#0A66C2",
        ["Null"] = "#94A3B8",
        ["TikTok"] = "#25F4EE",
        ["Twitch"] = "#9146FF",
        ["X"] = "#D1D5DB",
        ["YouTube"] = "#FF4444"
    };

    private RestreamControlState? _state;
    private bool _isWorking;
    private string _errorMessage = string.Empty;
    private string _ingestUrl = string.Empty;
    private string _recordingOutputPath = string.Empty;
    private string _brbSlatePath = string.Empty;
    private bool _startWithHost;

    private bool _hasState => _state is not null;
    private RestreamControlState CurrentState => _state ?? throw new InvalidOperationException("Restream state has not loaded yet.");

    protected override async Task OnInitializedAsync()
    {
        await RefreshState();
    }

    private async Task RefreshState()
    {
        await Execute(() => RestreamControlClient.GetState());
    }

    private async Task SaveConfiguration()
    {
        await Execute(
            () => RestreamControlClient.UpdateConfiguration(
                new RestreamConfigurationUpdateRequest
                {
                    IngestUrl = _ingestUrl,
                    RecordingOutputPath = _recordingOutputPath,
                    StartWithHost = _startWithHost,
                    BrbSlatePath = _brbSlatePath
                }));
    }

    private async Task ToggleRuntime()
    {
        if (_state is null)
        {
            return;
        }

        if (_state.IsFanoutRunning)
        {
            await Execute(() => RestreamControlClient.Stop());
            return;
        }

        await Execute(() => RestreamControlClient.Start());
    }

    private async Task ToggleDestination(RestreamDestinationState destination)
    {
        await Execute(
            () => RestreamControlClient.UpdateDestination(
                new RestreamDestinationUpdateRequest
                {
                    PlatformName = destination.PlatformName,
                    IsEnabled = !destination.IsEnabled
                }));
    }

    private async Task Execute(Func<Task<RestreamControlState>> action)
    {
        _isWorking = true;
        _errorMessage = string.Empty;

        try
        {
            _state = await action();
            ApplyConfiguration(_state);
        }
        catch (Exception ex)
        {
            _errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Restream control failed."
                : ex.Message;
        }
        finally
        {
            _isWorking = false;
        }
    }

    private void ApplyConfiguration(RestreamControlState state)
    {
        _ingestUrl = state.IngestUrl;
        _recordingOutputPath = state.RecordingOutputPath;
        _brbSlatePath = state.BrbSlatePath;
        _startWithHost = state.StartWithHost;
    }

    private string GetRuntimeSummary()
    {
        if (_state is null)
        {
            return "Loading current destination state.";
        }

        string startMode = _state.StartWithHost
            ? "Auto-start armed for Aspire."
            : "Manual start mode.";

        string runtimeSummary = _state.IsFanoutRunning
            ? $"Fanout running to {_state.ActiveDestinationCount} destination{GetPluralSuffix(_state.ActiveDestinationCount)}."
            : $"{_state.ActiveDestinationCount} connected destination{GetPluralSuffix(_state.ActiveDestinationCount)} ready.";

        return $"{runtimeSummary} {startMode}";
    }

    private string GetRuntimeButtonText()
    {
        if (_state?.IsFanoutRunning == true)
        {
            return "Stop restream";
        }

        return "Start restream";
    }

    private string GetRuntimeButtonCssClass()
    {
        return _state?.IsFanoutRunning == true
            ? "restream-panel__runtime-button--stop"
            : "restream-panel__runtime-button--start";
    }

    private static string GetPrimaryText(RestreamDestinationState destination)
    {
        return destination.IsConnected
            ? "Integration connected"
            : "Needs integration authorization";
    }

    private static string GetSecondaryText(RestreamDestinationState destination)
    {
        return destination.IsEnabled
            ? "Selected for fanout"
            : "Excluded from fanout";
    }

    private static string ResolvePlatformColor(string platformName)
    {
        return PlatformColors.TryGetValue(platformName, out string? color)
            ? color
            : "rgba(255,255,255,0.32)";
    }

    private static string GetPluralSuffix(int count)
    {
        return count == 1 ? string.Empty : "s";
    }
}

