@using Thiccdal.Modules.Control.Components.Integrations
@using Thiccdal.Infrastructure.Twitch
@inject IEmoteRenderingOptions EmoteRenderingOptions

<div class="operator-settings-dialog">
    <div class="operator-settings-dialog__tabs" role="tablist" aria-label="Operator settings sections">
        <button type="button"
                id="operator-settings-tab-stream-checks"
                class="operator-settings-dialog__tab @GetTabCssClass(OperatorSettingsTab.StreamChecks)"
                role="tab"
                aria-selected="@(_selectedTab == OperatorSettingsTab.StreamChecks)"
                aria-controls="operator-settings-panel-stream-checks"
                @onclick="() => SelectTab(OperatorSettingsTab.StreamChecks)">
            Stream Checks
        </button>
        <button type="button"
                id="operator-settings-tab-viewer-identities"
                class="operator-settings-dialog__tab @GetTabCssClass(OperatorSettingsTab.ViewerIdentities)"
                role="tab"
                aria-selected="@(_selectedTab == OperatorSettingsTab.ViewerIdentities)"
                aria-controls="operator-settings-panel-viewer-identities"
                @onclick="() => SelectTab(OperatorSettingsTab.ViewerIdentities)">
            Viewer Identities
        </button>
        <button type="button"
                id="operator-settings-tab-integrations"
                class="operator-settings-dialog__tab @GetTabCssClass(OperatorSettingsTab.Integrations)"
                role="tab"
                aria-selected="@(_selectedTab == OperatorSettingsTab.Integrations)"
                aria-controls="operator-settings-panel-integrations"
                @onclick="() => SelectTab(OperatorSettingsTab.Integrations)">
            Integrations
        </button>
        <button type="button"
                id="operator-settings-tab-emotes"
                class="operator-settings-dialog__tab @GetTabCssClass(OperatorSettingsTab.Emotes)"
                role="tab"
                aria-selected="@(_selectedTab == OperatorSettingsTab.Emotes)"
                aria-controls="operator-settings-panel-emotes"
                @onclick="() => SelectTab(OperatorSettingsTab.Emotes)">
            Emotes
        </button>
    </div>

    <div id="operator-settings-panel-stream-checks"
         class="operator-settings-dialog__panel"
         role="tabpanel"
         aria-labelledby="operator-settings-tab-stream-checks"
         hidden="@(_selectedTab != OperatorSettingsTab.StreamChecks)">
        <StreamInfoDialog />
    </div>

    <div id="operator-settings-panel-viewer-identities"
         class="operator-settings-dialog__panel"
         role="tabpanel"
         aria-labelledby="operator-settings-tab-viewer-identities"
         hidden="@(_selectedTab != OperatorSettingsTab.ViewerIdentities)">
        <ViewerIdentitiesPanel />
    </div>

    <div id="operator-settings-panel-integrations"
         class="operator-settings-dialog__panel"
         role="tabpanel"
         aria-labelledby="operator-settings-tab-integrations"
         hidden="@(_selectedTab != OperatorSettingsTab.Integrations)">
        <IntegrationsPanel />
    </div>

    <div id="operator-settings-panel-emotes"
         class="operator-settings-dialog__panel"
         role="tabpanel"
         aria-labelledby="operator-settings-tab-emotes"
         hidden="@(_selectedTab != OperatorSettingsTab.Emotes)">
        <div class="settings-row">
            <span class="settings-label">Animated emotes</span>
            <input type="checkbox" checked="@_useAnimatedEmotes" @onchange="HandleAnimatedEmotesChanged" id="emote-anim-toggle" />
            <label for="emote-anim-toggle">Use animated emotes in teleprompter &amp; overlay</label>
        </div>
    </div>
</div>

@code {
    private OperatorSettingsTab _selectedTab = OperatorSettingsTab.StreamChecks;
    private bool _useAnimatedEmotes;

    protected override void OnInitialized()
    {
        _useAnimatedEmotes = EmoteRenderingOptions.UseAnimatedEmotes;
    }

    private void SelectTab(OperatorSettingsTab tab)
    {
        _selectedTab = tab;
    }

    private string GetTabCssClass(OperatorSettingsTab tab)
    {
        return _selectedTab == tab
            ? "operator-settings-dialog__tab--active"
            : string.Empty;
    }

    private void HandleAnimatedEmotesChanged(ChangeEventArgs e)
    {
        _useAnimatedEmotes = (bool)(e.Value ?? false);
        EmoteRenderingOptions.SetUseAnimatedEmotes(_useAnimatedEmotes);
    }

    private enum OperatorSettingsTab
    {
        StreamChecks = 0,
        ViewerIdentities = 1,
        Integrations = 2,
        Emotes = 3
    }
}
