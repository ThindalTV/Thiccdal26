@using Thiccdal.Shared.Components.Components.Primitives
<div class="on-air">
    <div class="on-air__header">
        <span class="on-air__indicator">▶ ON AIR</span>
        <span class="on-air__dismiss-hint">tap anywhere to dismiss</span>
    </div>
    <div class="on-air__body">
        <div class="on-air__meta">
            <Badge Color="pending">TWITCH</Badge>
            <span class="on-air__user">StreamerFan99</span>
            <span class="on-air__time">2 min ago</span>
        </div>
        <p class="on-air__text">"What's your streaming setup? Which mic do you use?"</p>
    </div>
    <div class="on-air__footer">
        <span class="on-air__showing">Showing: 0:42</span>
        <PrimaryButton>LIVE ON OVERLAY</PrimaryButton>
        <span class="on-air__card-hint">tap card to dismiss</span>
    </div>
</div>
