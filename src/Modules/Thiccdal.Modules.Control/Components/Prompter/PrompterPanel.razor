@using Thiccdal.Infrastructure.Operators
@using Thiccdal.Infrastructure.Teleprompter
@inject IOperatorStateService OperatorStateService
<div class="ctrl-panel">
    <div class="ctrl-panel__header">
        <span class="ctrl-panel__title">Teleprompter</span>
        <span class="ctrl-panel__subtitle">Chat + Twitch activity</span>
    </div>
    <div class="ctrl-panel__body prompter__body">
        <button type="button" class="prompter__scroll" @onclick="ScrollReset">
            <span class="prompter__arrow prompter__hint">▲▲▲</span>
            <span class="prompter__hint">Latest messages</span>
        </button>
        <button type="button" class="prompter__scroll" @onclick="ScrollUp">
            <span class="prompter__arrow">▲</span>
            <span class="prompter__label">SCROLL UP</span>
            <span class="prompter__hint">later messages</span>
        </button>
        <button type="button" class="prompter__scroll" @onclick="ScrollDown">
            <span class="prompter__arrow">▼</span>
            <span class="prompter__label">SCROLL DOWN</span>
            <span class="prompter__hint">earlier chat</span>
        </button>
    </div>
</div>

@code {
    private void ScrollReset()
    {
        OperatorStateService.ScrollTeleprompter(ScrollDirection.Reset);
    }

    private void ScrollUp()
    {
        OperatorStateService.ScrollTeleprompter(ScrollDirection.Up);
    }

    private void ScrollDown()
    {
        OperatorStateService.ScrollTeleprompter(ScrollDirection.Down);
    }
}
