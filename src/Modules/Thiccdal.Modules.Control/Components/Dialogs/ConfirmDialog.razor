@if (_isOpen)
{
    <div class="confirm-dialog-backdrop" @onclick="HandleCancel" role="presentation">
        <div class="confirm-dialog" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="confirm-dialog-title">
            <div class="confirm-dialog__header">
                <h2 id="confirm-dialog-title" class="confirm-dialog__title">@_options.Title</h2>
                <button type="button" class="confirm-dialog__close" @onclick="HandleCancel" aria-label="Close">✕</button>
            </div>

            <p class="confirm-dialog__body">@_options.Body</p>

            @if (_options.Warnings.Count > 0)
            {
                <div class="confirm-dialog__warnings" role="alert">
                    <div class="confirm-dialog__warnings-title">Warnings</div>
                    <ul class="confirm-dialog__warnings-list">
                        @foreach (string warning in _options.Warnings)
                        {
                            <li>⚠ @warning</li>
                        }
                    </ul>
                </div>
            }

            <div class="confirm-dialog__actions">
                <button type="button" class="confirm-dialog__button confirm-dialog__button--cancel" @onclick="HandleCancel">Cancel</button>
                <button type="button" class="confirm-dialog__button @GetConfirmButtonClass()" @onclick="HandleConfirm">@_options.ConfirmText</button>
            </div>
        </div>
    </div>
}

@code {
    private ConfirmDialogOptions _options = new();
    private bool _isOpen;
    private TaskCompletionSource<bool>? _pendingConfirmation;

    internal Task<bool> Show(ConfirmDialogOptions options)
    {
        _pendingConfirmation?.TrySetResult(false);
        _options = options;
        _isOpen = true;
        _pendingConfirmation = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        _ = InvokeAsync(StateHasChanged);
        return _pendingConfirmation.Task;
    }

    private Task HandleConfirm()
    {
        Complete(true);
        return Task.CompletedTask;
    }

    private Task HandleCancel()
    {
        Complete(false);
        return Task.CompletedTask;
    }

    private void Complete(bool result)
    {
        _isOpen = false;
        _pendingConfirmation?.TrySetResult(result);
        _pendingConfirmation = null;
        _ = InvokeAsync(StateHasChanged);
    }

    private string GetConfirmButtonClass()
    {
        return _options.ConfirmStyle == ConfirmStyle.Danger
            ? "confirm-dialog__button--danger"
            : "confirm-dialog__button--primary";
    }
}
