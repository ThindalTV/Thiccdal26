@using Thiccdal.Infrastructure.Operators

@if (_isOpen)
{
    <div class="go-live-confirm-dialog-backdrop" @onclick="HandleCancel" role="presentation">
        <div class="go-live-confirm-dialog" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="go-live-confirm-dialog-title">
            <div class="go-live-confirm-dialog__header">
                <div>
                    <h2 id="go-live-confirm-dialog-title" class="go-live-confirm-dialog__title">Go Live?</h2>
                    <p class="go-live-confirm-dialog__body">The following required items are complete:</p>
                </div>
                <button type="button" class="go-live-confirm-dialog__close" @onclick="HandleCancel" aria-label="Close">✕</button>
            </div>

            <div class="go-live-confirm-dialog__summary">
                <ul class="go-live-confirm-dialog__summary-list" aria-label="Completed required items">
                    @foreach (string item in _summary.ConfirmedItems)
                    {
                        <li>✓ @item</li>
                    }
                </ul>
            </div>

            @if (_summary.Warnings.Count > 0)
            {
                <div class="go-live-confirm-dialog__warnings" role="alert">
                    <div class="go-live-confirm-dialog__warnings-title">Warnings</div>
                    <ul class="go-live-confirm-dialog__warnings-list">
                        @foreach (string warning in _summary.Warnings)
                        {
                            <li>⚠ @warning</li>
                        }
                    </ul>
                </div>
            }

            <div class="go-live-confirm-dialog__actions">
                <button type="button" class="go-live-confirm-dialog__button go-live-confirm-dialog__button--cancel" @onclick="HandleCancel">Cancel</button>
                <button type="button" class="go-live-confirm-dialog__button go-live-confirm-dialog__button--confirm" @onclick="HandleConfirm">Go Live</button>
            </div>
        </div>
    </div>
}

@code {
    private GoLiveChecklistSummary _summary = new();
    private bool _isOpen;
    private TaskCompletionSource<bool>? _pendingConfirmation;

    internal Task<bool> Show(PreLiveChecklistState checklistState)
    {
        _pendingConfirmation?.TrySetResult(false);
        _summary = GoLiveChecklistSummaryFactory.Create(checklistState);
        _isOpen = true;
        _pendingConfirmation = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        _ = InvokeAsync(StateHasChanged);
        return _pendingConfirmation.Task;
    }

    private Task HandleConfirm()
    {
        Complete(true);
        return Task.CompletedTask;
    }

    private Task HandleCancel()
    {
        Complete(false);
        return Task.CompletedTask;
    }

    private void Complete(bool result)
    {
        _isOpen = false;
        _pendingConfirmation?.TrySetResult(result);
        _pendingConfirmation = null;
        _ = InvokeAsync(StateHasChanged);
    }
}
