@using Thiccdal.Infrastructure.Bot
@using Thiccdal.Infrastructure.Bot.Models
@inject IBotCommandManagementService CommandManagementService
@inject ICommandDispatcher CommandDispatcher
@implements IAsyncDisposable

<div class="ctrl-panel bot-cmds-stretch">
    <div class="ctrl-panel__header bot-cmds__header">
        <div class="bot-cmds__header-copy">
            <span class="ctrl-panel__title">Bot Commands</span>
            <span class="bot-cmds__summary">@GetSummaryText()</span>
        </div>
    </div>
    <div class="ctrl-panel__body bot-cmds__body">
        <div class="bot-cmds__stats">
            <div class="bot-cmds__stat">
                <span class="bot-cmds__stat-label">Enabled</span>
                <strong class="bot-cmds__stat-value">@_commands.Count(static command => command.IsEnabled)</strong>
            </div>
            <div class="bot-cmds__stat">
                <span class="bot-cmds__stat-label">Disabled</span>
                <strong class="bot-cmds__stat-value">@_commands.Count(static command => !command.IsEnabled)</strong>
            </div>
            <div class="bot-cmds__stat">
                <span class="bot-cmds__stat-label">Most Used</span>
                <strong class="bot-cmds__stat-value">@GetMostUsedCommand()</strong>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="bot-cmds__success" role="status">@_statusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="bot-cmds__error" role="alert">@_errorMessage</div>
        }

        @if (_commands.Count == 0)
        {
            <div class="bot-cmds__empty">
                <p>No commands are configured yet. Add them in configuration and they appear here as one-tap buttons.</p>
            </div>
        }
        else
        {
            <div class="bot-cmds__quick-actions">
                <button type="button"
                        class="bot-cmds__action bot-cmds__action--primary"
                        disabled="@(!CanRunSelectedCommand() || _isBusy)"
                        @onclick="RunSelectedCommand">
                    @(_isBusy ? "Working..." : "Run Selected")
                </button>
            </div>

            <div class="bot-cmds__grid">
                @foreach (BotCommandDefinition command in _commands.Take(8))
                {
                    <BotCommandButton Command="@command.Trigger"
                                      Description="@BuildButtonDescription(command)"
                                      IsEnabled="@command.IsEnabled"
                                      IsSelected="@(command.Id == _selectedCommandId)"
                                      OnClick="@(() => SelectCommand(command.Id))" />
                }
            </div>

            @if (GetSelectedCommand() is BotCommandDefinition selectedCommand)
            {
                <div class="bot-cmds__detail">
                    <div class="bot-cmds__detail-header">
                        <div>
                            <div class="bot-cmds__detail-trigger">@selectedCommand.Trigger</div>
                            <div class="bot-cmds__detail-meta">@BuildButtonDescription(selectedCommand)</div>
                        </div>
                        <span class="bot-cmds__detail-state @(selectedCommand.IsEnabled ? "bot-cmds__detail-state--enabled" : "bot-cmds__detail-state--disabled")">
                            @(selectedCommand.IsEnabled ? "Ready to run" : "Paused")
                        </span>
                    </div>
                    <p class="bot-cmds__detail-response">@selectedCommand.ResponseTemplate</p>
                    <div class="bot-cmds__detail-footer">
                        <span>@(string.IsNullOrWhiteSpace(selectedCommand.HandlerType) ? "Template only" : "Handler + fallback")</span>
                        @if (!string.IsNullOrWhiteSpace(selectedCommand.HandlerType))
                        {
                            <code>@selectedCommand.HandlerType</code>
                        }
                    </div>
                </div>
            }
        }

        <p class="bot-cmds__hint">Tap a command to select it, then run it in chat. Add or edit commands in configuration.</p>
    </div>
</div>

@code {
    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private IReadOnlyList<BotCommandDefinition> _commands = Array.Empty<BotCommandDefinition>();
    private long? _selectedCommandId;
    private bool _isBusy;
    private string? _errorMessage;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await RefreshCommands();
    }

    public ValueTask DisposeAsync()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
        return ValueTask.CompletedTask;
    }

    private Task SelectCommand(long commandId)
    {
        BotCommandDefinition? selectedCommand = _commands.FirstOrDefault(command => command.Id == commandId);
        if (selectedCommand is null)
        {
            return Task.CompletedTask;
        }

        _selectedCommandId = selectedCommand.Id;
        _errorMessage = null;
        _statusMessage = null;
        return Task.CompletedTask;
    }

    private async Task RunSelectedCommand()
    {
        BotCommandDefinition? selectedCommand = GetSelectedCommand();
        if (selectedCommand is null)
        {
            _errorMessage = "Choose a saved command first.";
            return;
        }

        if (!selectedCommand.IsEnabled)
        {
            _errorMessage = $"{selectedCommand.Trigger} is paused. Enable it before running it live.";
            return;
        }

        _isBusy = true;
        _errorMessage = null;
        _statusMessage = null;

        try
        {
            await CommandDispatcher.DispatchFromOperator(selectedCommand.Trigger, _cancellationTokenSource.Token);
            await RefreshCommands(selectedCommand.Id);
            _statusMessage = $"Sent {selectedCommand.Trigger} to connected chat.";
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RefreshCommands(long? preferredCommandId = null)
    {
        try
        {
            _commands = await CommandManagementService.List(_cancellationTokenSource.Token);
            BotCommandDefinition? selectedCommand = null;

            if (preferredCommandId.HasValue)
            {
                selectedCommand = _commands.FirstOrDefault(command => command.Id == preferredCommandId.Value);
            }

            if (selectedCommand is null && _selectedCommandId.HasValue)
            {
                selectedCommand = _commands.FirstOrDefault(command => command.Id == _selectedCommandId.Value);
            }

            if (selectedCommand is null && _commands.Count > 0)
            {
                selectedCommand = _commands[0];
            }

            _selectedCommandId = selectedCommand?.Id;
        }
        catch (Exception exception)
        {
            _commands = Array.Empty<BotCommandDefinition>();
            _selectedCommandId = null;
            _errorMessage = exception.Message;
        }
    }

    private BotCommandDefinition? GetSelectedCommand()
    {
        if (_selectedCommandId.HasValue)
        {
            return _commands.FirstOrDefault(command => command.Id == _selectedCommandId.Value);
        }

        return _commands.Count > 0 ? _commands[0] : null;
    }

    private bool CanRunSelectedCommand()
    {
        return GetSelectedCommand()?.IsEnabled == true;
    }

    private string GetSummaryText()
    {
        if (_commands.Count == 0)
        {
            return "No commands configured";
        }

        return $"{_commands.Count(static command => command.IsEnabled)} live · {_commands.Count(static command => !command.IsEnabled)} paused";
    }

    private string GetMostUsedCommand()
    {
        BotCommandDefinition? mostUsedCommand = _commands
            .OrderByDescending(command => command.UseCount)
            .ThenBy(command => command.Trigger, StringComparer.Ordinal)
            .FirstOrDefault();

        return mostUsedCommand is null ? "—" : mostUsedCommand.Trigger;
    }

    private static string BuildButtonDescription(BotCommandDefinition command)
    {
        string status = command.IsEnabled ? "Live" : "Paused";
        return $"{status} · Used {command.UseCount}×";
    }

}
