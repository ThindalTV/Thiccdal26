@using Thiccdal.Infrastructure.Bot
@using Thiccdal.Infrastructure.Bot.Models
@inject IBotCommandManagementService CommandManagementService
@inject ICommandDispatcher CommandDispatcher
@implements IAsyncDisposable

<div class="ctrl-panel bot-cmds">
    <div class="ctrl-panel__header">
        <span class="ctrl-panel__title">Bot Commands</span>
        <span class="ctrl-panel__subtitle">@GetSummaryText()</span>
    </div>
    <div class="ctrl-panel__body bot-cmds__body">
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="bot-cmds__status" role="status">@_statusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="bot-cmds__error" role="alert">@_errorMessage</div>
        }

        @if (_commands.Count == 0)
        {
            <div class="bot-cmds__empty">
                <p>No commands are configured yet. Add them in configuration and they appear here as one-tap buttons.</p>
            </div>
        }
        else
        {
            <div class="bot-cmds__grid">
                @foreach (BotCommandDefinition command in _commands)
                {
                    <button type="button"
                            class="bot-cmds__command @(command.IsEnabled ? string.Empty : "bot-cmds__command--disabled")"
                            disabled="@(!command.IsEnabled || IsPending(command.Id))"
                            title="@command.ResponseTemplate"
                            @onclick="@(() => Run(command))">
                        <span class="bot-cmds__command-trigger">@command.Trigger</span>
                        <span class="bot-cmds__command-effects">@GetEffectText(command)</span>
                        <span class="bot-cmds__command-uses">@(IsPending(command.Id) ? "Running…" : $"Used {command.UseCount}×")</span>
                    </button>
                }
            </div>
        }

        <p class="bot-cmds__hint">Tap to run a command live. Add or edit commands in configuration.</p>
    </div>
</div>

@code {
    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private readonly HashSet<long> _pendingCommandIds = [];
    private IReadOnlyList<BotCommandDefinition> _commands = [];
    private string? _statusMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }

    public async ValueTask DisposeAsync()
    {
        await _cancellationTokenSource.CancelAsync();
        _cancellationTokenSource.Dispose();
    }

    private async Task Run(BotCommandDefinition command)
    {
        if (!command.IsEnabled || !_pendingCommandIds.Add(command.Id))
        {
            return;
        }

        _statusMessage = null;
        _errorMessage = null;

        try
        {
            await CommandDispatcher.DispatchFromOperator(command.Trigger, _cancellationTokenSource.Token);
            _statusMessage = $"Ran {command.Trigger} · {GetEffectText(command).ToLowerInvariant()}.";
            await Refresh();
        }
        catch (OperationCanceledException) when (_cancellationTokenSource.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _pendingCommandIds.Remove(command.Id);
        }
    }

    private async Task Refresh()
    {
        try
        {
            _commands = await CommandManagementService.List(_cancellationTokenSource.Token);
        }
        catch (OperationCanceledException) when (_cancellationTokenSource.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _commands = [];
            _errorMessage = exception.Message;
        }
    }

    private bool IsPending(long commandId)
    {
        return _pendingCommandIds.Contains(commandId);
    }

    private string GetSummaryText()
    {
        int enabled = _commands.Count(static command => command.IsEnabled);
        return enabled == 1 ? "1 command ready" : $"{enabled} commands ready";
    }

    private static string GetEffectText(BotCommandDefinition command)
    {
        List<string> effects = [];

        if (command.SendInChat)
        {
            effects.Add("Chat");
        }

        if (command.ShowOnLowerThird)
        {
            effects.Add("Lower third");
        }

        return effects.Count == 0 ? "No effects" : string.Join(" + ", effects);
    }
}
