@using Thiccdal.Shared.Components.Components.Primitives
<div class="ctrl-panel overlay-gallery-panel">
    <div class="ctrl-panel__header">
        <span class="ctrl-panel__title">Overlay Gallery</span>
        <span class="ctrl-panel__spacer"></span>
        <PrimaryButton>+ New Card</PrimaryButton>
    </div>
    <div class="ctrl-panel__body og-body">
        <p class="og-subtitle">Pre-configured cards — tap to push</p>
        <div class="og-grid">
            <OverlayCard Category="SPONSOR" Title="Use code THINDAL"
                Description="For 10% off at checkout" Color="#f0b429" />
            <OverlayCard Category="FOLLOW REMINDER" Title="Enjoying the stream?"
                Description="Hit that follow button!" Color="#3cc864" />
            <OverlayCard Category="DISCORD" Title="Join the community!"
                Description="discord.gg/thindal" Color="#5865F2" />
            <OverlayCard Category="BRB" Title="Be right back!"
                Description="Back in a few minutes" Color="#9146FF" />
            <OverlayCard Category="SOCIALS" Title="Find me everywhere"
                Description="&#64;thindal on all platforms" Color="#e84393" />
            <OverlayCard Category="CLIP ALERT" Title="Clip that!"
                Description="Use !clip in chat" Color="#00d4ff" />
        </div>
        <div class="og-new-row">
            <GhostButton>+ New Card</GhostButton>
            <GhostButton>+ New Card</GhostButton>
        </div>
    </div>
</div>
